---
import { configLoader } from "../utils/configLoader";
const CONFIG = await configLoader();

const logo_text = CONFIG.LOGO_TEXT ?? CONFIG.TITLE;

interface Props {
  sidebar: Boolean;
}

const { sidebar } = Astro.props;

const logo_post_override = CONFIG.LOGO_POST_OVERRIDE
  ? CONFIG.LOGO_POST_OVERRIDE
  : "";
const logo_sidebar_override = CONFIG.LOGO_SIDEBAR_OVERRIDE
  ? CONFIG.LOGO_SIDEBAR_OVERRIDE
  : "";
const logo_all_override = CONFIG.LOGO_ALL_OVERRIDE
  ? CONFIG.LOGO_ALL_OVERRIDE
  : "";

let logo_classes: string;
let wrapper_classes: string;
let logo_id: string;
if (sidebar) {
  logo_classes = " " + logo_sidebar_override;
  wrapper_classes = " ";
  logo_id = "logoSidebar";
} else {
  logo_classes = " " + logo_post_override;
  wrapper_classes =
    "transition-opacity duration-1000 flex justify-center w-64 md:hidden pt-5 md:pt-0 pl-20 pr-4";
  logo_id = "logoMain";
}
---

<div id={logo_id} class={`${wrapper_classes} `}>
  <a href="/" class="min-w-0 max-w-full"
    ><button
      class={`nought-stroke cursor-pointer text-center shadow-[4px_4px_0px_0px] hover:shadow-[0px_0px_0px_0px] px-2 py-1 border-2 rounded-field text-2xl font-bold bg-base-100 text-base-content border-base-content shadow-base-content transition-shadow duration-300 ease-in-out max-w-full break-normal whitespace-normal ${logo_all_override} ${logo_classes}`}
      ><Fragment set:html={logo_text} /></button
    >
  </a>
</div>
